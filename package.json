{
  "name": "nexastudios-launcher",
  "version": "0.1.0",
  "description": "Launcher de Minecraft Java Edition de NexaStudios",
  "author": "NexaStudios",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm run dev:main\"",
    "dev:main": "npm run build:main && wait-on tcp:5173 && cross-env NEXA_DEV=1 electron .",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "audit:deps": "npm audit --omit=dev",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.js",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  }
}
